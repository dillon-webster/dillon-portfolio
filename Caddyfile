{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# One big self-contained HTML file: revalidate often so a deploy is picked
	# up promptly, but let the ETag save the transfer when nothing changed.
	header *.html Cache-Control "public, max-age=60, must-revalidate"
}
